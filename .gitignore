# Local Claude Code session artifacts
.claude/bash-audit.log
.claude/settings.local.json

# OS noise
.DS_Store

# Scratch / working files
*.tmp
scratch/

# Skill packages written by `python3 install.py build` — rebuilt on demand, never committed
dist/

# Eval harness — regenerable per-batch files (sliced inputs, skill snapshots); runner scratch dirs are covered by scratch/
evals/runs/**/input/
evals/runs/**/skill/

# Python bytecode (install.py tests import the installer)
__pycache__/
*.pyc
